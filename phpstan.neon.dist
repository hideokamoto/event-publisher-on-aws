includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - src
        - event-publisher-on-aws.php
        - uninstall.php
    bootstrapFiles:
        - tests/phpstan-bootstrap.php
    ignoreErrors:
        - '#Function (add_action|add_filter|get_option|wp_remote_get|wp_remote_request|wp_json_encode) not found#'
        - '#Function __ not found#'