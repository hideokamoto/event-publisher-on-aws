{
  "core": "WordPress/WordPress#6.7",
  "phpVersion": "8.0",
  "plugins": [
    "."
  ],
  "env": {
    "tests": {
      "mappings": {
        "./tests": "/var/www/html/wp-content/plugins/event-publisher-on-aws/tests",
        "./phpunit.xml.dist": "/var/www/html/wp-content/plugins/event-publisher-on-aws/phpunit.xml.dist"
      }
    }
  },
  "config": {
    "WP_DEBUG": true,
    "WP_DEBUG_LOG": true,
    "WP_DEBUG_DISPLAY": false,
    "SCRIPT_DEBUG": true,
    "AWS_EVENTBRIDGE_ACCESS_KEY_ID": "test-access-key-id",
    "AWS_EVENTBRIDGE_SECRET_ACCESS_KEY": "test-secret-access-key",
    "EVENT_BRIDGE_REGION": "us-east-1"
  }
}
